# ==============================================================================
# SmartYatra - Environment Configuration Template
# NOTE: Never commit production credentials, real API keys, or database passwords.
# Copy this file to .env.local for local development.
# ==============================================================================

# Database Connection (PostgreSQL with Prisma ORM)
# Example for local PostgreSQL: postgresql://postgres:password@localhost:5432/smartyatra?schema=public
# Example for Supabase / Neon: postgresql://username:password@ep-cool-fog.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/smartyatra?schema=public"

# Session Security (HS256 Signing Secret for WebCrypto JWT Session Cookies)
# Generate a strong 32+ character random secret: openssl rand -base64 32
SESSION_SECRET="smartyatra-dev-super-secure-jwt-secret-key-32chars!"

# AI Service Provider (Google Gemini API)
# Get a key from Google AI Studio: https://aistudio.google.com/
# If absent, SmartYatra automatically and transparently operates in [Demo / Non-AI Fallback] mode.
GEMINI_API_KEY=""

# Application Environment
NODE_ENV="development"
PORT=3000

# Rate Limiting Configuration (Server-Side Sliding Window Thresholds)
# Maximum requests per 60-second window before HTTP 429 Retry-After is triggered
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=60

RATE_LIMIT_REGISTER_MAX=4
RATE_LIMIT_REGISTER_WINDOW=60

RATE_LIMIT_RESET_MAX=3
RATE_LIMIT_RESET_WINDOW=60

RATE_LIMIT_AI_MAX=10
RATE_LIMIT_AI_WINDOW=60

RATE_LIMIT_UPLOAD_MAX=6
RATE_LIMIT_UPLOAD_WINDOW=60

RATE_LIMIT_SEARCH_MAX=30
RATE_LIMIT_SEARCH_WINDOW=60

RATE_LIMIT_GENERAL_MAX=60
RATE_LIMIT_GENERAL_WINDOW=60
